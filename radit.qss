	background-color:rgb(82, 82, 82);
}


QFrame {
	border: 1px solid #000000;
 	background-color: rgb(52, 52, 52);

}


QTextEdit {
	background-color:rgb(42, 42, 42);
	color: rgb(0, 255, 0);
}

