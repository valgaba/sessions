QCheckBox {
	color:rgb(223,219,210);
	padding: 2px;
}
QCheckBox:hover {
	border-radius:4px;
	border-style:solid;
	padding-left: 1px;
	padding-right: 1px;
	padding-bottom: 1px;
	padding-top: 1px;
	border-width:1px;
	border-color: rgb(87, 97, 106);
	background-color:qlineargradient(spread:pad, x1:0.5, y1:0.7, x2:0.5, y2:0.3, stop:0 rgba(87, 97, 106, 150), stop:1 rgba(93, 103, 113, 150));
}
QCheckBox::indicator:checked {
	border-radius:4px;
	border-style:solid;
	border-width:1px;
	border-color: rgb(180,180,180);
  	background-color:qlineargradient(spread:pad, x1:0.5, y1:0.7, x2:0.5, y2:0.3, stop:0 rgba(87, 97, 106, 255), stop:1 rgba(93, 103, 113, 255));
}
QCheckBox::indicator:unchecked {
	border-radius:4px;
	border-style:solid;
	border-width:1px;
	border-color: rgb(87, 97, 106);
  	background-color:rgb(255,255,255);
}
QStatusBar {
	color:rgb(240,240,240);
}


/* background-color: rgb(51, 59, 79);*/



QScrollArea  {
    
	  
    /* background-color: rgb(51, 59, 79);*/
}



QSplitter{
	
	
   
	
  
}



QSplitter::handle{
	background-color: rgb(171, 171, 171);
	
   
	
  
}

QSplitter::handle:horizontal {
    width: 1px;
	
}

QSplitter::handle:vertical {
    height: 1px;
	
}





/*QSplitter:hover {

	background-color: rgb(255, 255, 255);
  
}

QSplitter::handle:pressed {

	background-color: rgb(255, 255, 255);
    
    
}*/



QScrollBar::vertical {
	background: rgb(52, 52, 52);
	width: 5px; 
}

QScrollBar::handle:vertical{
	 background: #77769d;  
	 height: 5px; 
	 width: 2px;
}

 QScrollBar::add-page{
	background: none;

}

  QScrollBar::sub-page {
	background: none;
}

/* quitar los botones de las barras */
QScrollBar::add-line:vertical {
height: 0px;
}

QScrollBar::sub-line:vertical {
height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
height: 0px;
}







QScrollBar::horizontal {
	background-color: rgb(52, 52, 52);
	height: 5px;
}

QScrollBar::handle:horizontal{ 
	background: #77769d;  
	height: 5px; 
	width: 2px;
}

QScrollBar::add-page{
	background: none;

}

QScrollBar::sub-page {
	background: none;
}

                             


/*  personalizados */



 QToolTip{  
	color: #7b8d96;
	
	
    background-color: rgb(51, 59, 79);
    border: 1px solid #686b74;

	font-size: 14px; /* Ajusta el tamaño de la fuente */
    padding: 5px; /* Opcional: Agrega un poco de espacio alrededor del texto */

}


QMessageBox {
    background-color: #282020;
}

QMessageBox QLabel {
    background-color: transparent;
    border: none;
    color: #8a8d96;
    font-size: 16px;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 6px 12px;
    border-radius: 4px;
    border: 1px solid #686b74;
    background-color: #262c3b;
    color: #8a8d96;


}

QMessageBox QPushButton:hover {
   border: 1px solid #7885a6;
}

QMessageBox QPushButton:pressed {
    background-color: #1d2230;
}






QInputDialog {
    background-color: #282020;
}

QInputDialog QLabel {
    background-color: transparent;
    border: none;
    color: #8a8d96;
    font-size: 16px;
}

QInputDialog QLineEdit {
    background-color: #262c3b;
    border: 1px solid #686b74;
    border-radius: 4px;
    padding: 6px;
    color: #8a8d96;
    font-size: 14px;
    selection-background-color: #7885a6;
    selection-color: #ffffff;
}

QInputDialog QLineEdit:focus {
    border: 1px solid #7885a6;
}

QInputDialog QPushButton {
    min-width: 80px;
    padding: 6px 12px;
    border-radius: 4px;
    border: 1px solid #686b74;
    background-color: #262c3b;
    color: #8a8d96;
}

QInputDialog QPushButton:hover {
    border: 1px solid #7885a6;
}

QInputDialog QPushButton:pressed {
    background-color: #1d2230;
}











/* ==========================================================================*/


/* ==========================================================================*/


#Contents {                   /* va bien asi */
     
	  background-color: rgb(40, 32, 32);
	  
}




#Container {                   /* va bien asi */
     
	background-color: #282020;
	border: 1px solid #333b4f;
    
	   
	
}



AudioItem
{
	background-color: #39385b;
	
   
}



AudioItemMaxi {
	
   background-color: #262c3b;
 
}  


AudioItemMaxi[playing="true"] {
    border: 2px solid #3ad5ff;
     
}

AudioItemMaxi[playing="false"] {
    border: 2px solid transparent;
}


Frame {
	border: 1px solid #333b4f;
    background-color: #262c3b;
   
	
	
}



Frame#framecenter,
Frame#frametop,
Frame#framedown {
    background-color: #181e2c;
}



Button {

border: 1px solid #686b74;
background-color: #262c3b;
color: #8a8d96;


}

Button:checked {
  /* background: #7885a6;*/
   background-color: rgba(0, 172, 252, 80);

}

Button:unchecked:hover{
   
}

Button:pressed{
    background: none;

}

Button:hover{
  border: 1px solid #7885a6;
 /* background-color: rgba(0, 172, 252, 50);*/
	
}


Button[nextcolor="true"] {
    background-color: #38b0d1;
}

Button[purgecolor="true"] {
    background-color: #d13838
}

Button[loopcolor="true"] {
    background-color: #38d17a;
}

Button[selectcolor="true"] {
    background-color: #745df7;
}

QPushButton#btnstop:pressed {
    background-color: #ebeaf3;
}



Button[playing="true"] {

   border-radius: 20px;
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #6f8f98,   /* brillo más apagado */
        stop:0.5 #5a7a83, /* base más oscura */
        stop:1 #3e585f    /* sombra profunda */
    );
    border: 1px solid #354a50;
}




VuMeter{
    background: transparent;
    border: none;
}

VuMeter QLabel {
    background: transparent;
    border: none;
    padding: 0;
    color: #8a8d96;
    font-size: 10px;
    font-weight: normal;
}

VuMeter LevelMeter {
    background-color: #181e2c;
    border: 1px solid #333b4f;
    border-radius: 0;
    padding: 0;
    qproperty-barColor: #80A4AE;
    qproperty-peakColor: #dfdbd2;
}

#VuMeterScale {
    color: #8a8d96;
    font-family: "Segoe UI", sans-serif;
    font-size: 8px;
    background: transparent;
    border: none;
}

#PlayerVolumeSlider::groove:horizontal,
#CaptureVolumeSlider::groove:horizontal,
#CastVolumeSlider::groove:horizontal,
#CueWaveformVolumeSlider::groove:horizontal,
#FolderAnnouncementVolume::groove:horizontal,
#FolderAnnouncementMusicVolume::groove:horizontal {
    border: 1px solid #686b74;
    height: 6px;
    background: #181e2c;
    border-radius: 3px;
}

#PlayerVolumeSlider::sub-page:horizontal,
#CaptureVolumeSlider::sub-page:horizontal,
#CastVolumeSlider::sub-page:horizontal,
#CueWaveformVolumeSlider::sub-page:horizontal,
#FolderAnnouncementVolume::sub-page:horizontal,
#FolderAnnouncementMusicVolume::sub-page:horizontal {
    background: #80A4AE;
    border-radius: 3px;
}

#PlayerVolumeSlider::handle:horizontal,
#CaptureVolumeSlider::handle:horizontal,
#CastVolumeSlider::handle:horizontal,
#CueWaveformVolumeSlider::handle:horizontal,
#FolderAnnouncementVolume::handle:horizontal,
#FolderAnnouncementMusicVolume::handle:horizontal {
    background: #80A4AE;
    border: 1px solid #80A4AE;
    width: 12px;
    margin: -4px 0;
    border-radius: 3px;
}

#PlayerVolumeValue,
#CaptureVolumeValue {
    color: #8a8d96;
    background: transparent;
    border: none;
}

#FolderAnnouncementVolumeValue,
#FolderAnnouncementMusicVolumeValue {
    color: #8a8d96;
    background: transparent;
    border: none;
}

Slider::groove:horizontal{
border: 1px solid #686b74;
height: 20px;
background: none;
margin: 2px 0;
}



Slider::handle:horizontal {
    background: #80A4AE;
    width: 18px;        /* ancho del handle */
    height: 14px;       /* más grande que antes */
    margin: 3px 0;      /* centrado verticalmente */
    border-radius: 5px;
}



Label{
padding: 2px;
border-radius: 0px;
border: 1px solid #686b74;
color: #8a8d96;
background: none;
border: none;

}

Label#AudioItemName {
    padding: 0px 2px 4px 2px;
}

Label#labelinfo{

border: none;


}



Label#labelnombre,
Label#labeltiempo{
   color: #8a8d96;
}



#Tab {
     background-color: #343434;
}



Tab::pane {

	
	

}

#TabBar {
	
   background-color: #343434;
    
	
 
}





TabBar::tab {
   
   
   
    color: #8a8d96;
	border: 1px solid #686b74;
    background-color: #262c3b;
   
	/*padding: 5px;
	margin-left: 5px;
	margin-top: 5px;
	margin-bottom: 5px;
    height: 12px;*/


	padding: 3px;
	margin-left: 3px;
	margin-top: 3px;
	margin-bottom: 3px;
    


   
}

TabBar::tab:selected {
    
	background-color: rgba(0, 172, 252, 80);
	background-color: #39385b;
}

TabBar::tab:hover {
	border: 1px solid #7885a6;
}

TabBar[playerTabs="true"]::tab {
    padding-top: 8px;
}

TabBar::tab:first {
    margin-left: 5px;
}

TabBar::tab:last {
    margin-right: 0;
}


TabBar::close-button {
	
  
	background-image: url(:/icons/Close-hover.svg);
   
}

TabBar::close-button:hover {
	
	
	background-image: url(:/icons/Close.svg);
   


}

TabBar::close-button:pressed {

    background-image: url(:/icons/Close.svg);
}


 TabBar QToolButton{

	width: 10px; /* Ajusta el ancho del botón según tus necesidades */
	height: 10px; /* Ajusta la altura del botón según tus necesidades */

}





TabBar QToolButton::right-arrow {

	
	background-color: #464675;
	border: 1px solid  #686b74;
   
    

 

		/* Estilos de fondo */
		background-image: url(:/icons/MoveRight.svg);
		
		background-repeat: no-repeat;
		background-position: center center;
		/*background-size: 50px 50px;  /* Ajusta el tamaño del icono */

		
   		/*margin-top: 5px;
		margin-bottom: 5px;*/

	
}







TabBar QToolButton::left-arrow {
	background-color: #262c3b;
	border: 1px solid #686b74;



	
	/* Estilos de fondo */
	background-image: url(:/icons/MoveLeft.svg);
	
		
	background-repeat: no-repeat;
	background-position: center center;
   /* background-size: 50px 50px;  /* Ajusta el tamaño del icono */


	    
   	/*	margin-top: 5px;
		margin-bottom: 5px;*/

	
	
	
		
	
}




TreeView {
	border: 1px solid #262c3b;
    background-color: #262c3b;
	color: #8a8d96;
	font-weight: bold;
	font-size: 14px;

}

TreeView::item:selected {
	color:rgb(255, 255, 255);
	border: 1px solid #7885a6;
	
}

TreeView::item:hover {
	color:rgb(255, 255, 255);
	border: 1px solid #7885a6;
	
}

TreeView::branch {
	image: none; /* Oculta la imagen de la flecha de despliegue */
}


ListView {
	border: 1px solid #333b4f;
    background-color: #262c3b;
	color: #8a8d96;
	font-weight: bold;
	font-size: 14px;

}

ListView::item:selected {
	color:rgb(255, 255, 255);
	border: 1px solid #7885a6;
	
}

ListView::item:hover {
	color:rgb(255, 255, 255);
	border: 1px solid #7885a6;
	
}



FrameView{
	border: 0px solid #333b4f;
	background-color: #000000;

}


